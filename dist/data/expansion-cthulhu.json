      "events": [
        {
          "id": "ct-event-silver",
          "title": "卡特寻找银钥匙并重返童年",
          "tier": 2,
          "era": "现代小说叙事；《银钥匙》写于1926年",
          "summary": "失去梦境的卡特沿着祖父梦中的提示返回故乡。",
          "detail": "钥匙、匣子、旧居与洞穴将物件探索转化为时间和身份的变化。故事把个人审美、失落与梦境置于中心，不能简化为一份跨维度法器说明书。",
          "actors": [
            "ct-carter"
          ],
          "source": "ct-src-silver"
        },
        {
          "id": "ct-event-haunter",
          "title": "布莱克开启晶体与停电之夜",
          "tier": 2,
          "era": "现代小说叙事；《夜魔》写于1935年",
          "summary": "废弃教堂中的探索，引出与晶体和黑暗有关的威胁。",
          "detail": "布莱克通过旧笔记和密码记录理解晶体，随后惧怕灯光消失。结尾并列雷击解释与他的惊恐日记，保留了叙述证据的裂缝。普罗维登斯是真实城市，小说中的经历及晶体流传史属于虚构。",
          "actors": [
            "ct-blake",
            "ct-nyarl"
          ],
          "source": "ct-src-haunter"
        }
      ],
      "relations": [],
      "artifacts": [
        {
          "id": "ct-book",
          "name": "死灵之书",
          "kind": "虚构文献",
          "tier": 1,
          "summary": "以伪造的译本史、馆藏与禁令串联故事的禁书。",
          "detail": "《死灵之书的历史》给它安排阿拉伯原名、希腊与拉丁译本及收藏机构。这些是作者营造可信感的文学手法。敦威治故事中的借阅与失窃情节，又使它成为知识既能揭示威胁也能帮助应对威胁的媒介。市面同名书不等于小说中确有其书。",
          "owners": [
            "ct-alhazred",
            "ct-armitage",
            "ct-wilbur"
          ],
          "events": [
            "ct-event-dunwich"
          ],
          "sources": [
            "ct-src-book"
          ]
        },
        {
          "id": "ct-obj-idol",
          "name": "克苏鲁石雕小像",
          "kind": "虚构造像",
          "tier": 1,
          "summary": "相似造像把分散的证词连成同一恐怖线索。",
          "detail": "《克苏鲁的呼唤》中，警方带来的石雕与其他证词互相呼应。叙事强调难以归类的材质和图像；这些是虚构调查的组成部分。洛夫克拉夫特的真实手绘可用来研究作者如何想象造像。",
          "owners": [
            "ct-cthulhu",
            "ct-thurston",
            "ct-johansen"
          ],
          "events": [
            "ct-event-dreams",
            "ct-event-rlyeh"
          ],
          "sources": [
            "ct-src-call"
          ]
        },
        {
          "id": "ct-obj-relief",
          "name": "威尔科克斯的梦境泥塑",
          "kind": "虚构造像",
          "tier": 2,
          "summary": "一块新制浮雕让梦境进入可被调查的物证世界。",
          "detail": "泥塑并非出土古物，而是艺术家根据梦境制作。它在第I部分出现，并与石雕构成视觉上的对应；阅读时应区分两个物件的来源。",
          "owners": [
            "ct-thurston",
            "ct-cthulhu"
          ],
          "events": [
            "ct-event-dreams"
          ],
          "sources": [
            "ct-src-call"
          ]
        },
        {
          "id": "ct-obj-trapezohedron",
          "name": "闪耀的偏方三八面体",
          "kind": "虚构宝石／媒介",
          "tier": 1,
          "summary": "教堂里的发光晶体，是观察异界与唤起夜魔的媒介。",
          "detail": "《夜魔》通过布莱克的日记与旧记录叙述晶体的流传和危险。它的异星、南极与埃及经历属于小说内的伪史，不能用来说明现实埃及宗教。中文名称存在不同译法，英文为 Shining Trapezohedron。",
          "owners": [
            "ct-blake",
            "ct-nyarl"
          ],
          "events": [
            "ct-event-haunter"
          ],
          "sources": [
            "ct-src-haunter"
          ]
        },
        {
          "id": "ct-obj-cylinder",
          "name": "米·戈脑罐与感官装置",
          "kind": "虚构技术",
          "tier": 1,
          "summary": "把离体脑与机器连接，许诺跨星际旅行，也引出欺骗与身份恐惧。",
          "detail": "《暗夜呢喃》中，圆筒配有可连接视听与发声装置的接口。叙述者听到机械话语，却无法完全确认背后的身份。这是生物与机器结合的科幻恐怖装置，不是现实医学技术。",
          "owners": [
            "ct-migo",
            "ct-akeley",
            "ct-wilmarth"
          ],
          "events": [
            "ct-event-whisper"
          ],
          "sources": [
            "ct-src-whisper"
          ]
        },
        {
          "id": "ct-obj-record",
          "name": "阿克利的留声机录音",
          "kind": "虚构证据",
          "tier": 2,
          "summary": "被录下的仪式声音使书信中的恐惧获得一种可重复的形式。",
          "detail": "录音与照片、黑石共同构成阿克利交出的证据。机械记录在故事中既增强可信感，也无法消除声音来源和解释的不确定性。",
          "owners": [
            "ct-akeley",
            "ct-wilmarth",
            "ct-migo"
          ],
          "events": [
            "ct-event-whisper"
          ],
          "sources": [
            "ct-src-whisper"
          ]
        },
        {
          "id": "ct-obj-black-stone",
          "name": "阿克利发现的黑石",
          "kind": "虚构铭刻",
          "tier": 3,
          "summary": "刻有奇异符号的石头，把山地传说转化为可调查的线索。",
          "detail": "黑石是来信提及的物证之一，并在后来遭到争夺。故事的线索链依赖信件、照片和个人叙述，读者始终无法获得完全独立的证明。",
          "owners": [
            "ct-akeley",
            "ct-wilmarth"
          ],
          "events": [
            "ct-event-whisper"
          ],
          "sources": [
            "ct-src-whisper"
          ]
        },
        {
          "id": "ct-obj-tiara",
          "name": "深潜者风格的金冠",
          "kind": "虚构饰物",
          "tier": 2,
          "summary": "博物馆中的异样头饰，为印斯茅斯的海洋世界埋下伏笔。",
          "detail": "叙述者观看一种难以归类的金属头饰；纹样与形制唤起不安。它把现代馆藏经验与虚构海底文明连接起来，并非已确认的真实考古类型。",
          "owners": [
            "ct-deep",
            "ct-dagon"
          ],
          "events": [
            "ct-event-innsmouth"
          ],
          "sources": [
            "ct-src-innsmouth"
          ]
        },
        {
          "id": "ct-obj-archive",
          "name": "伊斯图书馆中的自笔记录",
          "kind": "虚构文献",
          "tier": 2,
          "summary": "在远古遗迹中发现自己的字迹，是心智交换故事的关键证据。",
          "detail": "皮斯利在地底寻找档案，最终面对自己写下的记录。档案把记忆与物证连在一起；恐怖来自个人时间与人类历史尺度突然失配。",
          "owners": [
            "ct-peaslee",
            "ct-yith"
          ],
          "events": [
            "ct-event-yith"
          ],
          "sources": [
            "ct-src-time"
          ]
        },
        {
          "id": "ct-obj-silver-key",
          "name": "银钥匙",
          "kind": "虚构钥匙／门槛",
          "tier": 1,
          "summary": "卡特找回梦境能力的关键物件，联系祖传记忆与童年空间。",
          "detail": "《银钥匙》把钥匙的发现、故乡之行与时间经验的变化相连。此处依据该篇本身，不把后续作品或游戏中的全部规则合并成固定的通用能力。",
          "owners": [
            "ct-carter"
          ],
          "events": [
            "ct-event-silver"
          ],
          "sources": [
            "ct-src-silver"
          ]
        }
      ],
